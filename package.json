{
  "name": "phwalls",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "predev": "node scripts/generate-home-index.mjs",
    "prebuild": "node scripts/generate-home-index.mjs",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "next lint",
    "pages:build": "node scripts/generate-home-index.mjs && npx @cloudflare/next-on-pages",
    "preview": "npm run pages:build && wrangler pages dev .vercel/output/static",
    "deploy": "npm run pages:build && wrangler pages deploy .vercel/output/static --project-name phwalls"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20250913.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.544.0",
    "next": "^15.5.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^20.14.15",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.5.4"
  }
}
